{
  "name": "candela",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Candela: a physically based rendering workbench (TypeScript standalone port): fluent scene API, WebGPU/WebGL2 path tracer, agent",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "validate": "tsx scripts/validate.ts"
  },
  "dependencies": {
    "katex": "^0.16.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
